{
  "expo": {
    "name": "Hush",
    "slug": "hush",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "hush",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "userInterfaceStyle": "dark",
      "bundleIdentifier": "com.hush.app",
      "infoPlist": {
        "NSSupportsLiveActivities": true,
        "NSHealthShareUsageDescription": "Hush reads your weight and walks to learn your body faster.",
        "NSHealthUpdateUsageDescription": "Hush does not write to Health."
      },
      "entitlements": {
        "com.apple.developer.healthkit": true
      }
    },
    "android": {
      "userInterfaceStyle": "dark"
    },
    "plugins": [
      "expo-localization",
      "expo-secure-store"
    ]
  }
}
