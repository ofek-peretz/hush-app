{
  "expo": {
    "name": "Hush",
    "slug": "hush",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "hush",
    "userInterfaceStyle": "light",
    "backgroundColor": "#fbfaf8",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#fbfaf8"
    },
    "ios": {
      "supportsTablet": false,
      "userInterfaceStyle": "light",
      "bundleIdentifier": "com.hushfitness.app",
      "appleTeamId": "T6ZRTBRT2U",
      "buildNumber": "16",
      "infoPlist": {
        "NSSupportsLiveActivities": true,
        "NSHealthShareUsageDescription": "Hush reads your heart rate, calories and distance from Apple Health to record your runs and walks. It never writes to Health.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.developer.healthkit": true
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": ["CA92.1"]
          }
        ]
      }
    },
    "android": {
      "userInterfaceStyle": "light",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#08080E"
      }
    },
    "plugins": [
      "expo-localization",
      "expo-secure-store",
      "expo-notifications",
      "expo-dev-client",
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Hush reads your heart rate, calories and distance from Apple Health to record your runs and walks. It never writes to Health."
        }
      ],
      "@bacons/apple-targets",
      "expo-font",
      "expo-video"
    ],
    "extra": {
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "bundleIdentifier": "com.hushfitness.app.widget",
                  "targetName": "HushWidget"
                },
                {
                  "bundleIdentifier": "com.hushfitness.app.watch",
                  "targetName": "HushWatch"
                }
              ]
            }
          }
        },
        "projectId": "b838bf79-c406-4628-9098-2e5d809a9894"
      }
    },
    "owner": "ofekperetz1"
  }
}
