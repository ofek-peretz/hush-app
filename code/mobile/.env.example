# Hush mobile — environment variables.
# Copy to `.env` for local dev (Expo auto-loads it). For EAS builds these are
# set per-profile under `build.<profile>.env` in eas.json, or as EAS secrets.
#
# Only EXPO_PUBLIC_*-prefixed vars are embedded in the client bundle.

# Base URL of the Hush API (e.g. https://api.hush.app).
# Empty / unset => the app stays on the local fixture model and remains
# unenrolled (no telemetry sink). This is the intended default until the
# backend is reachable and an invite token is issued.
EXPO_PUBLIC_API_BASE_URL=
