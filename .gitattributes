# ============================================================================
# Hush — .gitattributes
# Normalize line endings and mark binary / generated files.
# ============================================================================

# Default: let Git normalize line endings on commit (store LF).
* text=auto

# Scripts that must stay LF (run on Linux containers / shells).
*.sh        text eol=lf
*.bash      text eol=lf
entrypoint.sh text eol=lf
Caddyfile*  text eol=lf

# Explicit text types.
*.py        text
*.ts        text
*.tsx       text
*.js        text
*.json      text
*.md        text
*.yml       text
*.yaml      text
*.toml      text
*.txt       text

# Generated lockfile — collapse diffs / review noise.
package-lock.json   linguist-generated=true

# Binary assets (never line-ending-normalized, never diffed as text).
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.pdf       binary
*.docx      binary
*.xlsx      binary
*.pptx      binary
*.db        binary
*.sqlite    binary
*.ttf       binary
*.otf       binary
*.woff      binary
*.woff2     binary
