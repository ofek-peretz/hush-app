# Hush v1 — environment contract (BB-30). Copy to a real .env that you NEVER commit, or (better in
# prod) inject these as environment variables straight from the secrets manager at process start.
# See docs/architecture/DEPLOYMENT_ARCHITECTURE_V1.md §3 for the authoritative table.
#
# Generate the two secrets with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Use DIFFERENT values for staging and prod — a staging secret must never authenticate against prod.

# --- plain config (not secret) ---
HUSH_DB_PATH=/data/hush.db          # the SQLite DB on the encrypted-at-rest volume (BB-21)
HUSH_AUTOCREATE_APP=1               # 1 = uvicorn builds app at import; prod migrates explicitly first (see entrypoint.sh)
HUSH_BASE_URL=http://127.0.0.1:8000 # base URL the ops monitor polls (set to the private service URL on the monitor host)

# --- secrets (FROM THE SECRETS MANAGER — never baked into the image, never committed, never logged) ---
HUSH_OPERATOR_KEY=                  # gates the entire /internal/* operator surface (BB-22). Rotatable: mint new -> update manager -> restart.
TOKEN_PEPPER=                       # mixed into every athlete-token hash (BB-20). SET-ONCE: rotating it invalidates every athlete token.
