    "/internal/gate/a7": {
      "get": {
        "description": "A7 week-1 seed-safety gate (BB-11) \u2014 the single hard Phase-1 gate. Computes per-cohort\nfirst-session completion + first-rep-failure rates and returns the per-cohort verdict + the overall\nPROCEED / PAUSE_AND_REANCHOR recommendation. Thresholds are RATIFIED (OD-8, V1) and the gate is\nARMED (status surfaced in the response); the only sanctioned response to an UNSAFE cohort is\nstop-and-re-anchor ES-008 v2, never a field parameter tweak (KL-9).",
        "operationId": "a7_gate_internal_gate_a7_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "A7 Gate",
        "tags": [
          "internal"
        ]
      }
    },
