{
  "components": {
    "schemas": {
      "CompleteRequest": {
        "description": "POST /sessions/{id}/complete \u2014 close (or finish-early). Idempotent on client_event_id.",
        "properties": {
          "client_event_id": {
            "minLength": 1,
            "title": "Client Event Id",
            "type": "string"
          },
          "finished_early": {
            "default": false,
            "title": "Finished Early",
            "type": "boolean"
          },
          "seq": {
            "default": 0,
            "minimum": 0.0,
            "title": "Seq",
            "type": "integer"
          }
        },
        "required": [
          "client_event_id"
        ],
        "title": "CompleteRequest",
        "type": "object"
      },
      "EnrollRequest": {
        "additionalProperties": false,
        "properties": {
          "age": {
            "minimum": 0.0,
            "title": "Age",
            "type": "integer"
          },
          "athlete_id": {
            "minLength": 1,
            "title": "Athlete Id",
            "type": "string"
          },
          "bodyweight_kg": {
            "anyOf": [
              {
                "exclusiveMinimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Bodyweight Kg"
          },
          "experience": {
            "title": "Experience",
            "type": "string"
          },
          "sex": {
            "title": "Sex",
            "type": "string"
          }
        },
        "required": [
          "athlete_id",
          "sex",
          "age",
          "experience"
        ],
        "title": "EnrollRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "ProfilePatchRequest": {
        "description": "PATCH /profile \u2014 correct an onboarding value. Only changed field(s) + client_request_id.",
        "properties": {
          "age": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Age"
          },
          "bodyweight_kg": {
            "anyOf": [
              {
                "exclusiveMinimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Bodyweight Kg"
          },
          "client_request_id": {
            "minLength": 1,
            "title": "Client Request Id",
            "type": "string"
          },
          "experience": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Experience"
          },
          "sex": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sex"
          }
        },
        "required": [
          "client_request_id"
        ],
        "title": "ProfilePatchRequest",
        "type": "object"
      },
      "ReplaceRequest": {
        "description": "POST /blocks/{id}/replace \u2014 L2 REPLACE (preference-driven, capability-preserving). Either\nin-catalog (to_exercise optional \u2192 server picks) or off-catalog (off_catalog_text, captured\nverbatim and losslessly for A9).",
        "properties": {
          "client_event_id": {
            "minLength": 1,
            "title": "Client Event Id",
            "type": "string"
          },
          "from_exercise": {
            "minLength": 1,
            "title": "From Exercise",
            "type": "string"
          },
          "off_catalog_text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Off Catalog Text"
          },
          "reason": {
            "default": "",
            "title": "Reason",
            "type": "string"
          },
          "seq": {
            "minimum": 0.0,
            "title": "Seq",
            "type": "integer"
          },
          "to_exercise": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "To Exercise"
          }
        },
        "required": [
          "client_event_id",
          "seq",
          "from_exercise"
        ],
        "title": "ReplaceRequest",
        "type": "object"
      },
      "RevokeRequest": {
        "additionalProperties": false,
        "properties": {
          "token": {
            "minLength": 1,
            "title": "Token",
            "type": "string"
          }
        },
        "required": [
          "token"
        ],
        "title": "RevokeRequest",
        "type": "object"
      },
      "SessionStartRequest": {
        "description": "POST /sessions \u2014 no athlete-supplied composition parameters (composition is server-owned\nand load-free; the client cannot influence it). Idempotent on client_request_id.",
        "properties": {
          "client_request_id": {
            "minLength": 1,
            "title": "Client Request Id",
            "type": "string"
          }
        },
        "required": [
          "client_request_id"
        ],
        "title": "SessionStartRequest",
        "type": "object"
      },
      "SetReportRequest": {
        "additionalProperties": false,
        "description": "POST /sessions/{id}/sets \u2014 the core learning input. `extra=\"forbid\"`: an unknown field\n(effort/RIR/proximity-to-failure) is a model-boundary violation \u2192 422 (contract \u00a77.1/\u00a716C).",
        "properties": {
          "actual_reps": {
            "minimum": 0.0,
            "title": "Actual Reps",
            "type": "integer"
          },
          "actual_weight": {
            "anyOf": [
              {
                "exclusiveMinimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Actual Weight"
          },
          "block_id": {
            "minLength": 1,
            "title": "Block Id",
            "type": "string"
          },
          "client_event_id": {
            "minLength": 1,
            "title": "Client Event Id",
            "type": "string"
          },
          "seq": {
            "minimum": 0.0,
            "title": "Seq",
            "type": "integer"
          },
          "set_number": {
            "minimum": 1.0,
            "title": "Set Number",
            "type": "integer"
          }
        },
        "required": [
          "client_event_id",
          "seq",
          "block_id",
          "set_number",
          "actual_reps"
        ],
        "title": "SetReportRequest",
        "type": "object"
      },
      "SkipRequest": {
        "description": "POST /blocks/{id}/skip \u2014 a welcomed first-class path (not a failure). `reason` is free-form\naudit text, NOT a model input.",
        "properties": {
          "client_event_id": {
            "minLength": 1,
            "title": "Client Event Id",
            "type": "string"
          },
          "reason": {
            "default": "",
            "title": "Reason",
            "type": "string"
          },
          "seq": {
            "minimum": 0.0,
            "title": "Seq",
            "type": "integer"
          }
        },
        "required": [
          "client_event_id",
          "seq"
        ],
        "title": "SkipRequest",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
