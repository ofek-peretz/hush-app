{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ferrox",
  "compatibility_date": "2026-09-15",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "dist"
  },
  "routes": [
    { "pattern": "getferrox.com", "custom_domain": true },
    { "pattern": "www.getferrox.com", "custom_domain": true }
  ]
}
